{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IsoHopper",
  "version": "0.1.0",
  "identifier": "org.isohopper.studio",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "IsoHopper \u00b7 Experimental",
        "width": 1440,
        "height": 1000,
        "minWidth": 820,
        "minHeight": 640,
        "backgroundColor": "#0c1218",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "shortDescription": "Experimental multiboot toolkit",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
